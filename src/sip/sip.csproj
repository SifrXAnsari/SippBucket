<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SippBucket.CliShim</RootNamespace>
    <!-- The command is 'sip', not 'sippbucket'. -->
    <AssemblyName>sip</AssemblyName>
    <!-- A shim over SippBucket.Cli. Nothing here is a public API. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SippBucket.Cli\SippBucket.Cli.csproj" />
  </ItemGroup>

</Project>