<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SippBucket.Cli</RootNamespace>
    <AssemblyName>SippBucket.Cli</AssemblyName>
    <!--
      The command surface, as a library, so exactly one implementation serves both the
      standalone `sip` shim and the combined SippBucket application. Duplicating it - or
      linking the same source into two projects - would let the two drift, and the CLI is
      the surface the power-user help documents.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SippBucket.Core\SippBucket.Core.csproj" />
  </ItemGroup>

</Project>