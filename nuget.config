<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned deliberately. The machine-level NuGet config on this box carries a dead
  local source and a dead fallback package folder on a D: drive that no longer
  exists; either one fails every restore with NU1301 or an MSB4018 crash inside
  FallbackPackagePathResolver. Clearing both here keeps the build reproducible
  without editing machine state.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
